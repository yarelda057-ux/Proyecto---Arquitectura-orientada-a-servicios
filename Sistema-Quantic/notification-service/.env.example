NODE_ENV=development
HOST=127.0.0.1
PORT=8002
SOAP_PUBLIC_URL=http://127.0.0.1:8002
SOAP_CLIENT_KEYS_JSON={"inventory":"replace-this-inventory-key-with-32-characters","catalogos":"replace-this-catalog-key-with-32-characters","esb":"replace-this-esb-key-with-32-characters"}
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=quantic_notifications
WORKER_INTERVAL_MS=60000
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=notificaciones@example.com

