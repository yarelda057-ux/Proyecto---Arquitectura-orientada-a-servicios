NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/inventario
# Generar JWT_SECRET con crypto.randomBytes(48).toString('base64')
JWT_SECRET=
SESSION_TTL_SECONDS=3600
CLIENT_ORIGINS=http://localhost:5173

# Claves independientes; nunca usar VITE_* para estos secretos.
AUDIT_ENABLED=false
AUDIT_SERVICE_URL=http://127.0.0.1:8001
AUDIT_WRITE_KEY=
AUDIT_READ_KEY=
INTEGRATION_ESB_URL=http://127.0.0.1:8003
INTEGRATION_ESB_KEY=

# Pasarela hacia el servicio de mayoristas
WHOLESALE_SERVICE_URL=http://127.0.0.1:3001
WHOLESALE_INTEGRATION_KEY=

REPORTS_INTEGRATION_KEY=REPLACE_WITH_REPORTS_CLIENT_SECRET
