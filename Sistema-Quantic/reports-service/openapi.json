            }
          },
          "401": {
            "description": "Autenticación ausente o vencida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              }
            }
          },
          "403": {
            "description": "Permisos insuficientes",
