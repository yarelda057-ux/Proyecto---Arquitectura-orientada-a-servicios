{
  "openapi": "3.1.0",
  "info": {
    "title": "Servicio de Reportes y Dashboards de Inventario",
    "version": "1.0.0",
    "description": "API REST/JSON de Reportes y Dashboards. Requiere JWT de integración para audience reports-api, issuer registrado y permisos reports:read/reports:write. Las consultas a stock también necesitan X-Stock-Authorization con el prefijo Bearer. El backend del inventario obtiene estas credenciales al actuar como consumidor."
  },
  "servers": [
    {
      "url": "/",
      "description": "Origen del servicio actual"
    }
  ],
  "paths": {
    "/api/v1/inventario/reportes": {
      "post": {
        "operationId": "generarReporte",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Stock-Authorization",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Credencial Bearer delegada de la fuente"
          },
          {
            "in": "header",
            "name": "X-Correlation-ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tipo": {
                    "const": "stockActual"
                  },
                  "formato": {
                    "const": "JSON"
                  },
                  "filtros": {
                    "$ref": "#/components/schemas/Filtros"
                  },
                  "versionInventario": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "tipo",
                  "formato",
                  "versionInventario"
                ]
              },
              "example": {
                "tipo": "stockActual",
                "filtros": {
                  "categoria": "redes"
                },
                "formato": "JSON",
                "versionInventario": "INV-106"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resultado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "idReporte": {
                      "type": "string"
                    },
                    "tipo": {
                      "const": "stockActual"
                    },
                    "datos": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Producto"
                      }
                    },
                    "versionInventario": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "actualizadoEn": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "generadoEn": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "sinRegistros": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Permisos insuficientes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Recurso inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Versión no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Fuente o persistencia no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "504": {
            "description": "Tiempo de espera agotado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Reportes"
        ]
      }
    },
