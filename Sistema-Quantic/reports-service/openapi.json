    "/api/v1/inventario/dashboards/{idDashboard}": {
      "put": {
        "operationId": "actualizarDashboard",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Stock-Authorization",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Credencial Bearer delegada de la fuente"
          },
          {
            "in": "header",
            "name": "X-Correlation-ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "idDashboard",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "versionInventario": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "filtros": {
                    "$ref": "#/components/schemas/Filtros"
                  },
                  "nombre": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "indicadores": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "totalProductos",
                        "productosConStock",
                        "productosSinStock",
                        "unidadesDisponibles"
                      ]
                    }
                  }
                },
                "required": [
                  "nombre",
                  "indicadores",
                  "versionInventario"
                ]
              },
              "example": {
                "nombre": "Disponibilidad comercial",
                "indicadores": [
                  "productosConStock",
                  "productosSinStock"
                ],
                "filtros": {
                  "categoria": "redes"
                },
                "versionInventario": "INV-106"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "idDashboard": {
                      "type": "string"
                    },
                    "indicadores": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "versionInventario": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "actualizadoEn": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "generadoEn": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "sinRegistros": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Permisos insuficientes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Recurso inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Versión no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Fuente o persistencia no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "504": {
            "description": "Tiempo de espera agotado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Dashboards"
        ]
      },
      "get": {
        "operationId": "consultarDashboard",
        "description": "Sin actual=true devuelve configuracion almacenada con historico=true. Con actual=true consulta la fuente y devuelve indicadores, grupos, proveedores, clasificacion, catalogo de filtros y configuracion; nunca usa cache si falla la fuente.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "idDashboard",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "actual",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "in": "header",
            "name": "X-Stock-Authorization",
            "description": "Obligatoria si actual=true.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Configuracion historica o resultado vigente con fechas y version."
          },
          "400": {
            "description": "Entrada invalida"
          },
          "401": {
            "description": "Credencial invalida"
          },
          "403": {
            "description": "Permisos insuficientes"
          },
          "404": {
            "description": "Dashboard inexistente"
          },
          "409": {
            "description": "Operacion o version en conflicto"
          },
          "503": {
            "description": "Fuente no disponible"
          },
          "504": {
            "description": "Timeout"
          }
        },
        "tags": [
          "Dashboards"
        ]
      }
    },
    "/api/v1/inventario/actualizaciones": {
      "post": {
        "operationId": "actualizarDashboardsPorVersion",
        "description": "Extension para coordinadores. Actualiza todos los dashboards del consumidor con una version exacta; conserva filtros y nombre. idOperacion es idempotente. Una version antigua queda SUPERADO sin sobrescribir un resultado mas reciente.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Stock-Authorization",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "idOperacion",
                  "versionInventario"
                ],
                "properties": {
                  "idOperacion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "versionInventario": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acuse durable con idOperacion, versionInventario y dashboards (idDashboard, estado ACTUALIZADO/SUPERADO, versionDashboard)."
          },
          "400": {
            "description": "Entrada invalida"
          },
          "401": {
            "description": "Credencial invalida"
          },
          "403": {
            "description": "Permisos insuficientes"
          },
          "409": {
            "description": "Operacion o version en conflicto"
          },
          "503": {
            "description": "Fuente no disponible"
          },
          "504": {
            "description": "Timeout"
          }
        },
        "tags": [
          "Reportes"
        ]
      }
    },
