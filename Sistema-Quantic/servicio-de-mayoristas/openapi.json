    "/api/v1/stock/eventos-stock": {
      "get": {
        "summary": "Eventos durables de versiones confirmadas (solo administrador o coordinador).",
        "parameters": [
          {
            "in": "query",
            "name": "despues",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "eventos: hasta 25 elementos ordenados con versionInventario, secuencia, actorId, idLote, idOperacion, actualizadoEn."
          },
          "400": {
            "description": "Secuencia invalida"
          },
          "403": {
            "description": "No autorizado"
          }
        }
      }
    },
    "/api/v1/stock/snapshot": {
      "get": {
        "summary": "Inventario completo y consistente, o version historica exacta. El alcance del mayorista se aplica tambien al historico.",
        "parameters": [
          {
            "in": "query",
            "name": "versionInventario",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "versionInventario, revisionInventario, actualizadoEn, total y productos. Cada producto contiene idProducto, idMayorista, nombre, stock, categoria y categoriaOrigen."
          },
          "409": {
            "description": "Version no conservada"
          },
          "503": {
            "description": "Replica set no disponible o version incompleta"
          }
        }
