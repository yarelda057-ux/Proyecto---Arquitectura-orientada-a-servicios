{
  "openapi": "3.0.3",
  "info": {
    "title": "Servicio de Gestión de Stock de Mayoristas",
    "version": "1.0.0",
    "description": "La columna Categoria es opcional: prioridad categoria explicita, seccion reconocida, descripcion y finalmente Sin categoria. La confirmacion conserva stock, snapshot y evento dentro de la misma transaccion."
  },
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
